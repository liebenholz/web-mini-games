# ------------------------------------------------------------
# GitHub "Node" 템플릿을 기반으로, 이 모노레포에 맞게 정리하고 추가한 항목
# ------------------------------------------------------------

# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
out/
*.tsbuildinfo
.vite/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test / coverage
coverage/
.nyc_output/
junit.xml
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Load test & report artifacts (raw results only; summaries go in docs/reports)
loadtest/results/
*.k6.json

# Environment / secrets  (.env.example is committed)
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
id_ed25519*

# Local infra data (docker volumes bound to the repo)
infra/data/
infra/**/pgdata/
infra/**/redis-data/
infra/**/caddy_data/
infra/**/caddy_config/

# Caches
.cache/
.eslintcache
.prettiercache
.turbo/
.parcel-cache/

# Cloudflare / Wrangler local state
.wrangler/
.dev.vars

# Claude Code (shared settings in .claude/settings.json ARE committed)
.claude/settings.local.json
CLAUDE.local.md

# Editors / OS
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# 부하 테스트 결과 (docs/ops/load-test.md). 보고서만 docs/reports에 남긴다
loadtest-*.json
