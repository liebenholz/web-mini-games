# 키 이름만 적는다. 실제 값은 .env(커밋 금지) 또는 GitHub Secrets에 둔다.

# --- server ---
NODE_ENV=development
PORT=2567
# 허용할 클라이언트 Origin (쉼표 구분). 예: https://play.example.com
CORS_ORIGINS=http://localhost:5173
# 비워 두면 DB 없이 동작한다 (판 기록 저장 안 함)
DATABASE_URL=
# 비워 두면 단일 프로세스 메모리 presence를 쓴다
REDIS_URL=
# 테스트 전용. NODE_ENV=production에서 true면 서버가 시작을 거부한다 (S-04)
ALLOW_TEST_SEED=false
# graceful shutdown 시 진행 중인 방을 기다리는 최대 시간(초)
SHUTDOWN_DRAIN_SECONDS=900
# 사람 1명 + 봇만 남았을 때 처리 (S-10 미결정). continue | end
ALONE_WITH_BOTS_POLICY=continue
# 운영 지표 /metrics를 여는 토큰 (24자 이상). 비우면 /metrics는 503이고 지표는 로그로만 남는다
METRICS_TOKEN=
# 운영 지표를 로그로 남기는 간격(초). 0이면 남기지 않는다
METRICS_INTERVAL_SECONDS=60
# IP별 분당 방 만들기·입장 요청 수 (0이면 끄기, 부하 테스트 때만)
MATCHMAKE_PER_MINUTE=60

# --- infra/docker-compose ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
API_DOMAIN=
SERVER_IMAGE=

# --- client (Vite, 빌드 시 주입) ---
VITE_SERVER_URL=ws://localhost:2567

# 개발·E2E 전용: 시간 배율 (0 < x ≤ 1). 운영에서는 1이 아니면 시작 거부
GAME_TIMING_SCALE=1
