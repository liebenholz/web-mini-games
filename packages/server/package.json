{
  "name": "@wmg/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --conditions=source src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node dist/scripts/migrate.js",
    "replay": "tsx --conditions=source src/scripts/replay.ts"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.29",
    "@colyseus/redis-driver": "^0.18.7",
    "@colyseus/redis-presence": "^0.18.6",
    "@colyseus/schema": "^5.0.50",
    "@colyseus/ws-transport": "^0.18.5",
    "@wmg/rules": "workspace:*",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.10",
    "@colyseus/testing": "^0.18.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15"
  }
}
